---
import "../styles/global.css";
import { Toaster } from "@/components/ui/sonner";

type Props = {
  title?: string;
};

const { title = "yapca" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title}</title>
    <script is:inline>
      // Mirrors `TIME_ZONE_COOKIE` from `src/lib/timezone.ts`, which an is:inline script cannot import.
      try {
        const timeZone = Intl.DateTimeFormat().resolvedOptions().timeZone;
        const secure = location.protocol === "https:" ? "; Secure" : "";

        document.cookie = `tz=${encodeURIComponent(timeZone)}; Path=/; SameSite=Lax; Max-Age=31536000${secure}`;
      } catch {
        // Cookie APIs can be unavailable in privacy modes.
      }
    </script>
  </head>
  <body>
    <slot />
    <Toaster client:load />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
