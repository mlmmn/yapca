---
import Header from "@/components/header.astro";
import Layout from "@/layouts/layout.astro";
import TodayList from "@/components/today-list";
import { loadTodayPlants } from "@/lib/services/load-today-plants";

const { plants } = await loadTodayPlants(Astro.request.headers, Astro.cookies);
---

<Layout>
  <div class="flex min-h-screen flex-col">
    <Header current="today" />

    <div class="flex flex-1 justify-center px-6 py-10">
      <div class="w-full max-w-xl">
        {
          plants === null ? (
            <TodayList client:load plants={[]} fetchError today={Astro.locals.today} />
          ) : (
            <TodayList client:load plants={plants} today={Astro.locals.today} />
          )
        }
      </div>
    </div>
  </div>
</Layout>
