---
import { formatDueLabel, formatIntervalLabel } from "@/lib/date";
import { getSeason, getShortSeasonLabel, selectSeasonInterval } from "@/lib/season";

type Props = {
  growingIntervalDays: number;
  dormancyIntervalDays: number;
  dueDate: string;
  mode: "active" | "full";
};

const { growingIntervalDays, dormancyIntervalDays, dueDate, mode } = Astro.props;
const today = Astro.locals.today;
const season = today === null ? null : getSeason(today);
const activeInterval = today === null ? null : selectSeasonInterval(today, growingIntervalDays, dormancyIntervalDays);
const seasonLabel = season === null ? null : getShortSeasonLabel(season);
const fallbackSchedule = `Growing: ${formatIntervalLabel(growingIntervalDays)} · Dormancy: ${formatIntervalLabel(dormancyIntervalDays)}`;
const schedule =
  mode === "full"
    ? [
        `Growing: ${formatIntervalLabel(growingIntervalDays)}${season === "growing" ? " (active now)" : ""}`,
        `Dormancy: ${formatIntervalLabel(dormancyIntervalDays)}${season === "dormancy" ? " (active now)" : ""}`,
      ].join(" · ")
    : `${seasonLabel} · then ${formatIntervalLabel(activeInterval ?? growingIntervalDays)}`;
const summary = today === null ? fallbackSchedule : schedule;
const dueLabel = formatDueLabel(dueDate, today);
---

<div class="text-muted-foreground min-w-0 space-y-1 text-sm">
  <div>{dueLabel}</div>
  <div class="text-xs leading-5">{summary}</div>
</div>
