---
import { getSummaryValues } from "./utils";

type Props = {
  growingIntervalDays: number;
  dormancyIntervalDays: number;
  dueDate: string;
  initialToday: string | null;
  mode: "active" | "full";
};

const { growingIntervalDays, dormancyIntervalDays, dueDate, initialToday, mode } = Astro.props;
const fallback = getSummaryValues(mode, dueDate, growingIntervalDays, dormancyIntervalDays, initialToday);
---

<div
  class="text-muted-foreground min-w-0 space-y-1 text-sm"
  data-season-interval-summary
  data-due-date={dueDate}
  data-growing-interval-days={growingIntervalDays}
  data-dormancy-interval-days={dormancyIntervalDays}
  data-initial-today={initialToday ?? ""}
  data-mode={mode}
>
  <div data-due-label>{fallback.dueLabel}</div>
  <div class="text-xs leading-5" data-schedule>{fallback.schedule}</div>
</div>

<script>
  import { subscribeToBrowserToday } from "@/lib/timezone";
  import { getSummaryValues } from "./utils";

  type SummaryElement = HTMLElement & {
    dataset: DOMStringMap & {
      dormancyIntervalDays: string;
      dueDate: string;
      growingIntervalDays: string;
      initialToday: string;
      mode: "active" | "full";
    };
  };

  const summaries = [...document.querySelectorAll<SummaryElement>("[data-season-interval-summary]")];
  // Every summary on a page shares one SSR seed, so the first instance carries it
  // for the single page-level subscription.
  const initialToday = summaries[0]?.dataset.initialToday || null;

  const unsubscribe = subscribeToBrowserToday((today) => {
    for (const summary of summaries) {
      const dueLabel = summary.querySelector<HTMLElement>("[data-due-label]");
      const schedule = summary.querySelector<HTMLElement>("[data-schedule]");
      const values = getSummaryValues(
        summary.dataset.mode,
        summary.dataset.dueDate,
        Number(summary.dataset.growingIntervalDays),
        Number(summary.dataset.dormancyIntervalDays),
        today,
      );

      if (dueLabel) {
        dueLabel.textContent = values.dueLabel;
      }

      if (schedule) {
        schedule.textContent = values.schedule;
      }
    }
  }, initialToday);

  // Hoisted scripts re-run on every swap once a ClientRouter is added, and `summaries`
  // is a snapshot of the outgoing document. Without this the old subscription keeps its
  // listeners and timer alive against a detached subtree, once per navigation.
  document.addEventListener("astro:before-swap", unsubscribe, { once: true });
</script>
