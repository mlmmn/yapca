---
type Props = {
  message: string;
};

const { message } = Astro.props;
---

<div class="border-destructive/30 mb-6 rounded-md border px-4 py-3">
  <div class="flex items-start gap-3">
    <svg
      class="text-destructive mt-0.5 h-5 w-5 flex-shrink-0"
      aria-hidden="true"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
    >
      <circle cx="12" cy="12" r="10"></circle>
      <line x1="12" y1="8" x2="12" y2="12"></line>
      <line x1="12" y1="16" x2="12.01" y2="16"></line>
    </svg>
    <p class="text-foreground text-sm">{message}</p>
  </div>
</div>
