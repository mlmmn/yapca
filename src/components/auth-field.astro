---
import type { HTMLInputTypeAttribute } from "react";

type Props = {
  name: string;
  type: HTMLInputTypeAttribute;
  label: string;
  autocomplete?: string;
  required?: boolean;
  minlength?: number;
  describedById?: string;
  hint?: string;
  autofocus?: boolean;
};

const {
  name,
  type,
  label,
  autocomplete,
  required = true,
  minlength,
  describedById,
  hint,
  autofocus = false,
} = Astro.props;
---

<div class="mb-4">
  <label for={name} class="text-foreground mb-2 block text-sm font-medium">
    {label}
  </label>
  {
    /* eslint-disable astro/jsx-a11y/no-autofocus -- callers opt in via the `autofocus` prop; brief §6 wants focus on the email field (works JS-off) */
  }
  <input
    id={name}
    name={name}
    type={type}
    autocomplete={autocomplete}
    required={required}
    minlength={minlength}
    aria-describedby={describedById}
    autofocus={autofocus}
    class="border-input bg-background text-foreground placeholder-muted-foreground focus:border-ring focus:ring-ring/30 w-full rounded-md border px-3 py-2 text-sm transition-colors outline-none focus:ring-2"
  />
  {
    hint && describedById && (
      <p id={describedById} class="text-muted-foreground mt-1.5 text-sm">
        {hint}
      </p>
    )
  }
</div>
