---
import { buttonVariants } from "@/components/ui/button";
import EditPlantForm from "@/components/edit-plant-form";
import Header from "@/components/header.astro";
import Layout from "@/layouts/layout.astro";
import { createClient } from "@/lib/supabase";
import { resolvePhotoUrl } from "@/lib/photo";

type PlantEdit = {
  id: string;
  name: string;
  growing_interval_days: number;
  dormancy_interval_days: number;
  next_due_on: string;
  photo_path: string | null;
  updated_at: string;
};

async function loadPlant(plantId: string): Promise<{ plant: PlantEdit | null; photoUrl: string | null }> {
  const supabase = createClient(Astro.request.headers, Astro.cookies);

  if (!supabase) {
    return { plant: null, photoUrl: null };
  }

  const { data: plantData } = await supabase
    .from("plants")
    .select("id, name, growing_interval_days, dormancy_interval_days, next_due_on, photo_path, updated_at")
    .eq("id", plantId)
    .maybeSingle();

  if (!plantData) {
    return { plant: null, photoUrl: null };
  }

  const plant = plantData;
  const photoUrl = plant.photo_path ? await resolvePhotoUrl(supabase, plant.photo_path) : null;

  return { plant, photoUrl };
}

const plantId = Astro.params.id;
const { plant, photoUrl } = await loadPlant(plantId ?? "");

if (!plantId || !plant) {
  Astro.response.status = 404;
}

const initial = plant?.name.trim().charAt(0).toUpperCase() ?? "?";
---

<Layout title={plant ? `Edit ${plant.name} · yapca` : "Plant not found · yapca"}>
  <div class="flex min-h-screen flex-col">
    <Header current="edit-plant" />

    <div class="flex flex-1 justify-center px-6 py-10">
      <div class="w-full max-w-sm">
        {
          plant ? (
            <>
              <a
                href={`/plants/${plant.id}`}
                class="text-muted-foreground hover:text-foreground mb-6 inline-flex items-center gap-1 text-sm"
              >
                &larr; Back to {plant.name}
              </a>
              <h1 class="mb-3 text-2xl font-medium">Edit plant</h1>
              <div class="text-muted-foreground mb-6 flex min-w-0 items-center gap-2 text-sm">
                <div class="bg-muted flex size-8 shrink-0 items-center justify-center overflow-hidden rounded-md">
                  {photoUrl ? (
                    <img src={photoUrl} alt="" class="size-full object-cover" />
                  ) : (
                    <span class="font-medium">{initial}</span>
                  )}
                </div>
                <span class="min-w-0 truncate">{plant.name}</span>
              </div>
              <EditPlantForm
                client:load
                plantId={plant.id}
                name={plant.name}
                growingIntervalDays={plant.growing_interval_days}
                dormancyIntervalDays={plant.dormancy_interval_days}
                nextDueOn={plant.next_due_on}
                updatedAt={plant.updated_at}
                photoUrl={photoUrl}
                today={Astro.locals.today}
              />
            </>
          ) : (
            <div class="py-16 text-center">
              <h1 class="mb-4 text-2xl font-medium">Plant not found</h1>
              <p class="text-muted-foreground mb-6 text-sm">
                This plant may have been removed or isn't available to this account.
              </p>
              <a href="/plants" class:list={buttonVariants({ variant: "default" })}>
                Back to all plants
              </a>
            </div>
          )
        }
      </div>
    </div>
  </div>
</Layout>
