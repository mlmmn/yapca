---
import { buttonVariants } from "@/components/ui/button";
import Wordmark from "@/components/wordmark.astro";
import Layout from "@/layouts/layout.astro";
import AddPlantForm from "@/components/add-plant-form";
---

<Layout title="Add plant · yapca">
  <div class="flex min-h-screen flex-col">
    <div class="border-border bg-background border-b px-6 py-4">
      <div class="flex items-center justify-between">
        <Wordmark size="sm" />
        <form method="post" action="/api/auth/signout">
          <button type="submit" class:list={buttonVariants({ variant: "ghost" })}> Sign out </button>
        </form>
      </div>
    </div>

    <div class="flex flex-1 justify-center px-6 py-10">
      <div class="w-full max-w-sm">
        <a href="/" class="text-muted-foreground hover:text-foreground mb-6 inline-flex items-center gap-1 text-sm">
          &larr; Today
        </a>
        <h1 class="mb-6 text-2xl font-medium">Add plant</h1>
        <AddPlantForm client:load />
      </div>
    </div>
  </div>
</Layout>
